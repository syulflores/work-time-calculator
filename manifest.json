{
  "manifest_version": 3,
  "name": "Work Time Left",
  "version": "0.9.2",
  "description": "Read-only work hours calculator to see what time you need to clock out by.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://paychex.centralservers.com/*"
  ],
  "icons": {
    "16": "assets/icons/work-time-left-16.png",
    "32": "assets/icons/work-time-left-32.png",
    "48": "assets/icons/work-time-left-48.png",
    "128": "assets/icons/work-time-left-128.png"
  },
  "action": {
    "default_title": "Work Time Left",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/work-time-left-16.png",
      "24": "assets/icons/work-time-left-24.png",
      "32": "assets/icons/work-time-left-32.png"
    }
  }
}
